{
  "name": "plantuml-diagrams",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && youtrack-app validate dist",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test src/widgets/plantuml-app/*.test.ts",
    "pack": "rm -f app.zip && cd dist && zip -qr ../app.zip .",
    "upload": "youtrack-app upload dist"
  },
  "dependencies": {
    "@jetbrains/ring-ui-built": "^6.0.56",
    "@plantuml/core": "1.2026.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@jetbrains/eslint-config": "^5.4.2",
    "@jetbrains/youtrack-apps-tools": "^0.0.1-alpha.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "license": "MIT"
}
